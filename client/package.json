{
  "name": "vastora-crm-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n SA,AD,AM,DL -c blue,magenta,green,yellow \"npm run dev:super\" \"npm run dev:admin\" \"npm run dev:am\" \"npm run dev:dealer\"",
    "dev:super": "vite --mode super --port 5173 --strictPort",
    "dev:admin": "vite --mode admin --port 5174 --strictPort",
    "dev:am": "vite --mode am --port 5175 --strictPort",
    "dev:dealer": "vite --mode dealer --port 5176 --strictPort",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "vite": "^6.0.6"
  }
}
